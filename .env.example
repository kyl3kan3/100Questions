# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres and Managed Neon Auth
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-AUTH-ENDPOINT.neonauth.REGION.aws.neon.tech/DATABASE/auth
NEON_AUTH_COOKIE_SECRET=generate-at-least-32-random-characters

# Comma-separated Neon Auth user IDs that bypass credits and per-user quotas
UNLIMITED_ACCESS_USER_IDS=

# Stripe Checkout (one-time prepaid run-credit packages)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_INTRO=price_REPLACE_ME
STRIPE_PRICE_SINGLE=price_REPLACE_ME
STRIPE_PRICE_THREE=price_REPLACE_ME
STRIPE_PRICE_TEN=price_REPLACE_ME

# Vercel AI Gateway model routing (Vercel deployments use OIDC)
AI_GATEWAY_OPENAI_MODEL=openai/gpt-5.4-mini
AI_GATEWAY_ANTHROPIC_MODEL=anthropic/claude-sonnet-4.6
AI_GATEWAY_GOOGLE_MODEL=google/gemini-3.1-flash-lite
AI_GATEWAY_XAI_MODEL=xai/grok-4.5
AI_GATEWAY_ANALYSIS_MODEL=openai/gpt-5.4-nano

# Budget and durable-workflow guardrails
ESTIMATED_MICROS_PER_PROVIDER_CALL=12000
BUDGET_MICROS_PER_PROVIDER_CALL=19000
WORKFLOW_BATCH_SIZE=5
WORKFLOW_MAX_ATTEMPTS=2
DAILY_RUN_LIMIT=3
DAILY_COST_LIMIT_MICROS=12000000
RUN_RETENTION_DAYS=30
CRON_SECRET=replace-with-a-random-secret
